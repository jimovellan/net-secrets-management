{
  "name": "net-secrets-manager",
  "displayName": "%extension.displayName%",
  "publisher": "dotnet-secrets-manager",
  "description": "Manage .NET User Secrets for your projects from VS Code.",
  "version": "1.0.1",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jimovellan/net-secrets-management.git"
  },
  "bugs": {
    "url": "https://github.com/jimovellan/net-secrets-management/issues"
  },
  "homepage": "https://github.com/jimovellan/net-secrets-management#readme",
  "keywords": [
    ".NET",
    "dotnet",
    "user-secrets",
    "secrets",
    "csproj"
  ],
  "engines": {
    "vscode": "^1.142.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "net-secrets-manager.openDashboard",
        "title": "%command.openDashboard%"
      },
      {
        "command": "net-secrets-manager.browseSecrets",
        "title": "%command.browseSecrets%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "net-secrets-manager.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-CN",
            "hi",
            "es",
            "fr",
            "ar",
            "bn",
            "pt-BR",
            "ru",
            "ur"
          ],
          "enumDescriptions": [
            "%language.auto%",
            "%language.english%",
            "%language.chinese%",
            "%language.hindi%",
            "%language.spanish%",
            "%language.french%",
            "%language.arabic%",
            "%language.bengali%",
            "%language.portuguese%",
            "%language.russian%",
            "%language.urdu%"
          ],
          "default": "en",
          "description": "%language.description%"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "net-secrets-manager.openDashboard",
          "when": "resourceExtname == .csproj",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsix": "vsce package",
    "publish:marketplace": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
